#node-border {
    background-color: rgb(91, 91, 91);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    min-height: 50px;
    align-items: stretch;
}

#input {
    align-items: center;
    justify-content: flex-start;
    align-self: auto;
    height: auto;
    max-height: none;
    font-size: 0;
    position: relative;
    flex-shrink: 1;
    background-color: rgb(38, 38, 38);
    min-height: 10px;
}

#output {
    align-items: center;
    justify-content: flex-start;
    align-self: auto;
    min-height: 10px;
    background-color: rgba(38, 38, 38, 0);
    position: relative;
    bottom: auto;
    right: auto;
    top: auto;
    margin-top: 0;
}

#selection-border {
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    position: absolute;
    align-items: stretch;
}

:hover > #selection-border {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-left-color: rgb(64, 157, 255);
    border-right-color: rgb(64, 157, 255);
    border-top-color: rgb(64, 157, 255);
    border-bottom-color: rgb(64, 157, 255);
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

:selected > #selection-border {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    border-left-color: rgb(64, 157, 255);
    border-right-color: rgb(64, 157, 255);
    border-top-color: rgb(64, 157, 255);
    border-bottom-color: rgb(64, 157, 255);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

:hover:selected > #selection-border {
    border-left-color: rgb(32, 74, 204);
    border-right-color: rgb(32, 74, 204);
    border-top-color: rgb(32, 74, 204);
    border-bottom-color: rgb(32, 74, 204);
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.node {
    min-width: 150px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    min-height: auto;
}

#divider {
    min-height: 1px;
    background-color: rgb(75, 75, 75);
    position: relative;
    align-items: stretch;
    justify-content: flex-start;
    flex-shrink: 1;
    flex-grow: 0;
}

#title {
    min-height: auto;
    font-size: 18px;
    -unity-text-align: middle-center;
}

.RootNode #input {
    background-color: rgb(249, 56, 39);
}

.ControlFlowNode #input {
    background-color: rgb(255, 157, 35);
}

.ControlFlowNode #node-border {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    background-image: none;
}

.DecoNode {
    rotate: 0;
    width: auto;
    min-width: 250px;
    min-height: 100px;
    height: auto;
    max-height: none;
    background-color: rgba(0, 0, 0, 0);
}

.DecoNode #node-border {
    rotate: 0;
    width: auto;
    min-width: auto;
    min-height: auto;
    position: relative;
    background-image: url("project://database/Assets/Editor/BehaviorEditor/NodeImages/DecorationNode.png?fileID=2800000&guid=20cce617f65747b46ad5c340d46ff0b5&type=3#DecorationNode");
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(91, 91, 91);
}

.DecoNode #top {
    rotate: 0;
    width: auto;
    min-width: auto;
    min-height: auto;
    position: relative;
    background-image: none;
}

.DecoNode #input {
    background-color: rgba(255, 214, 90, 0);
    align-items: stretch;
    left: auto;
    background-image: url("project://database/Assets/Editor/BehaviorEditor/NodeImages/InputPortImg.png?fileID=2800000&guid=109fe9b061bcefc4d95dcaae7eb641fc&type=3#InputPortImg");
    min-width: auto;
    min-height: 20px;
    width: 50px;
    height: auto;
    -unity-background-image-tint-color: rgb(255, 214, 90);
    position: relative;
    overflow: visible;
    visibility: visible;
    right: auto;
    top: auto;
    display: flex;
    align-self: center;
}

.DecoNode #divider {
    rotate: 0;
    width: auto;
    min-width: 0;
    min-height: 0;
    height: auto;
    max-height: none;
    background-color: rgba(0, 0, 0, 0);
}

.ActionNode #input {
    background-color: rgb(22, 196, 127);
}

#title #Description {
    font-size: 12px;
    -unity-text-align: lower-center;
}

.Success #state-border {
    border-left-color: rgb(41, 255, 0);
    border-right-color: rgb(41, 255, 0);
    border-top-color: rgb(41, 255, 0);
    border-bottom-color: rgb(41, 255, 0);
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.Failure #state-border {
    border-left-color: rgb(255, 0, 0);
    border-right-color: rgb(255, 0, 0);
    border-top-color: rgb(255, 0, 0);
    border-bottom-color: rgb(255, 0, 0);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.Running #state-border {
    border-left-color: rgb(0, 182, 255);
    border-right-color: rgb(0, 182, 255);
    border-top-color: rgb(0, 182, 255);
    border-bottom-color: rgb(0, 182, 255);
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
}
